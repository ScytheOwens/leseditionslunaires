{% extends "layout.html.twig" %}

{% block title %}Catalogue{% endblock %}

{% block meta %}
    <meta name="title" content="Catalogue">
    <meta name="description" content="Découvrez le catalogue des Editions Lunaires, spécialisée dans les genres de l'imaginaire tels que la fantasy, le fantastique et la science-fiction.">
{% endblock %}

{% block main %}
    {% include "component/_breadcrumbs.html.twig" with {
        'breadcrumbs': breadcrumbs
    } %}

    {% include "widget/_widget_header.html.twig" with {
        'page_title': 'Nos parutions, une littérature de l\'imaginaire',
        'page_description': 'Découvrez des récits SFFF centrés sur la psychologie des personnages et la complexité des relations humaines. Explorations amorales, intrigues organiques, et proses travaillées, vibrez dans notre univers.'
    } %}

    {% for category in categories %}
        {% if category.products is not empty %}
            {% include "/wrapper/product/_widget_display.html.twig" with {
                'title': category.name,
                'description': category.description,
                'products': category.products
            } %}
        {% endif %}
    {% endfor %}
{% endblock %}
