{% extends "layout.html.twig" %}

{% block title %}{{ product.name }}{% endblock %}

{% block meta %}
    <meta name="title" content="{{ product.name }}">
    <meta name="description" content="{{ product.description }}">
{% endblock %}

{% block main %}
    {% include "component/_breadcrumbs.html.twig" with {
        'breadcrumbs': breadcrumbs
    } %}

    {% include "wrapper/product/_widget_presentation.html.twig" with {
        'product': product
    } %}

    {% include "widget/_widget_tabs.html.twig" with {
        'tabs': tabs
    } %}
{% endblock %}