    {% include "widget/_widget_text.html.twig" with {
        'title': '1/ L\'éditeur',
        'content': [
            {
                'content': 'GRONDIN Maëva <br/>9 rue Centrale - 69720 Saint Laurent de Mure - France <br/>contact@leseditionslunaires.fr <br/>07 50 43 99 45'
            }
        ]
